# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Hostinger Chambers Email Defaults (/mail uses IMAP 993 + SMTP 465 over TLS)
MAIL_DEFAULT_EMAIL="services@sjalaw.in"
MAIL_IMAP_HOST="imap.hostinger.com"
MAIL_IMAP_PORT="993"
MAIL_SMTP_HOST="smtp.hostinger.com"
MAIL_SMTP_PORT="465"

# Optional server-side SMTP credentials to forward consultation notes automatically
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
MAIL_NOTIFY_TO="services@sjalaw.in"

# Optional secret used to encrypt stateless /mail session cookies on serverless hosts (e.g. Vercel)
MAIL_SESSION_SECRET=""
